---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// The archive ends in 2015 and the professional/TPM writing starts in 2026 —
// an 11-year gap in the actual content, so a fixed cutoff here won't need
// revisiting as new posts land in future years the way a "current year"
// check would.
const ARCHIVE_CUTOFF_YEAR = 2016;
const recentPosts = publishedPosts.filter(p => p.data.date.getFullYear() >= ARCHIVE_CUTOFF_YEAR);
const archivePosts = publishedPosts.filter(p => p.data.date.getFullYear() < ARCHIVE_CUTOFF_YEAR);

const blogDateFormatter = new Intl.DateTimeFormat('en-US', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

---

<BaseLayout title="Writing" description="All posts by Galaxy Kadiyala">
  <section class="section">
    <div class="container">

      <div class="page-header">
        <h1>Writing</h1>
        <p>{publishedPosts.length} posts since 2010 on program management, systems thinking, QA,
and a long history of open-web community work.</p>
        <a href="/blog/tags" class="topics-link">Browse by topic →</a>
      </div>

      <div class="blog-list">
        {recentPosts.map((post) => (
          <div class="blog-row">
            <div class="blog-row-meta">
              <time class="blog-row-date">
                {blogDateFormatter.format(post.data.date)}
              </time>
            </div>
            <div class="blog-row-content">
              <h2 class="blog-row-title">
                <a href={`/blog/${post.slug}`} class="blog-row-link">{post.data.title}</a>
              </h2>
              {post.data.description && <p class="blog-row-desc">{post.data.description}</p>}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="blog-row-tags">
                  {post.data.tags.map(tag => (
                    <a href={`/blog/tags/${tag}`} class="blog-row-tag">{tag}</a>
                  ))}
                </div>
              )}
            </div>
            <span class="blog-row-arrow">→</span>
          </div>
        ))}
      </div>

      <div class="archive-section">
        <h2 class="archive-heading">The Mozilla Years (2010–2015)</h2>
        <p class="archive-desc">Fifteen years of open-web community work — student ambassador programs, meetups, and the early days of Mozilla Reps in India.</p>

        <div class="archive-list">
          {archivePosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="archive-item">
              <time class="archive-date">{blogDateFormatter.format(post.data.date)}</time>
              <span class="archive-title">{post.data.title}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.page-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 2px solid var(--ink);
}
.page-header h1 {
  margin-bottom: 0.5rem;
}
.page-header p {
  font-family: var(--mono);
  font-size: 0.85rem;
  opacity: 0.5;
}
.topics-link {
  display: inline-block;
  margin-top: 0.75rem;
  font-family: var(--mono);
  font-size: 0.8rem;
  opacity: 0.45;
  transition: opacity 0.15s;
}
.topics-link:hover { opacity: 1; color: var(--accent); }

.blog-list {
  display: flex;
  flex-direction: column;
}

.blog-row {
  position: relative;
  display: grid;
  grid-template-columns: 200px 1fr 2rem;
  gap: 2rem;
  align-items: start;
  padding: 1.75rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
  transition: background 0.15s;
  border-radius: 4px;
  padding-inline: 0.5rem;
  cursor: pointer;
}
.blog-row:hover { background: var(--paper-2); }

.blog-row-meta {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-top: 0.2rem;
}

.blog-row-date {
  font-family: var(--mono);
  font-size: 0.78rem;
  opacity: 0.45;
}

.blog-row-title {
  font-size: 1.2rem;
  line-height: 1.25;
  margin-bottom: 0.5rem;
}

.blog-row-link {
  color: inherit;
  text-decoration: none;
  transition: color 0.15s;
}
.blog-row-link::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 4px;
}
.blog-row:hover .blog-row-link { color: var(--accent); }

.blog-row-desc {
  font-size: 0.92rem;
  opacity: 0.6;
  font-family: var(--serif);
}

.blog-row-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 14px;
  margin-top: 0.6rem;
}

.blog-row-tag {
  position: relative;
  z-index: 1;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.03em;
  color: var(--accent);
  background: none;
  border: none;
  padding: 0;
  text-decoration: none;
  opacity: 0.8;
  transition: opacity 0.15s;
}
.blog-row-tag:hover { opacity: 1; }

.blog-row-arrow {
  font-family: var(--sans);
  font-size: 1.2rem;
  opacity: 0.3;
  align-self: center;
  transition: all 0.15s;
}
.blog-row:hover .blog-row-arrow { opacity: 1; transform: translateX(4px); }

/* ── Archive section ─────────────────────────────── */
.archive-section {
  margin-top: 3.5rem;
  padding-top: 2.5rem;
  border-top: 2px solid var(--ink);
}

.archive-heading {
  font-size: 1.4rem;
  margin-bottom: 0.5rem;
}

.archive-desc {
  font-family: var(--serif);
  font-size: 0.95rem;
  opacity: 0.6;
  max-width: 62ch;
  line-height: 1.6;
  margin-bottom: 2rem;
}

.archive-list {
  display: flex;
  flex-direction: column;
}

.archive-item {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 1.5rem;
  padding: 0.65rem 0.5rem;
  color: inherit;
  text-decoration: none;
  border-radius: 4px;
  transition: background 0.15s, opacity 0.15s;
}
.archive-item:hover {
  background: var(--paper-2);
}
.archive-item:hover .archive-title {
  color: var(--accent);
}

.archive-date {
  font-family: var(--mono);
  font-size: 0.75rem;
  opacity: 0.4;
  white-space: nowrap;
  padding-top: 0.1rem;
}

.archive-title {
  font-size: 0.95rem;
  transition: color 0.15s;
}

@media (max-width: 640px) {
  .archive-item {
    grid-template-columns: 1fr;
    gap: 0.15rem;
  }
}

@media (max-width: 640px) {
  .blog-row {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
  }
  .blog-row-meta {
    flex-direction: row;
    align-items: center;
    grid-column: 1 / -1;
  }
  .blog-row-arrow { grid-row: 1; }
}
</style>
