---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { testimonials } from '../data/testimonials';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// Server-rendered fallback so there's no flash of empty content and the
// page works with JS disabled — the inline script below silently swaps
// this for a random pick from the full list on load.
const defaultTestimonial = testimonials.find(t => t.name === 'Shreya Shetty') ?? testimonials[0];

const featuredProjects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

function fmtDate(d: Date) {
  const currentYear = new Date().getFullYear();
  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };
  if (d.getFullYear() !== currentYear) {
    opts.year = 'numeric';
  }
  return d.toLocaleDateString('en-US', opts);
}
---

<BaseLayout
  title="Galaxy Kadiyala — TPM · Systems · AI"
  description="Technical Program Manager focused on systems thinking, AI workflows, and building leverage. Based in Bengaluru."
>
  <div class="home">

    <section class="hero">
      <p class="eyebrow">Technical Program Manager &middot; AI &middot; Systems</p>
      <h1>Systems &gt; effort.<br/><span class="hero-accent">I build leverage.</span></h1>
      <p class="lead">15+ years across Nutanix, Everpure, and Rubrik. 2 US patents in distributed systems. AI is a tool. Systems do the work.</p>
      <div class="hero-cta">
        <a href="/projects" class="btn">Projects</a>
        <a href="/blog" class="btn outline">Writing</a>
      </div>
    </section>

    <div class="home-testimonial" id="homepage-testimonial" data-testimonials={JSON.stringify(testimonials)}>
      <p class="testimonial-quote" id="testimonial-quote">"{defaultTestimonial.quote}"</p>
      <p class="testimonial-name" id="testimonial-name">{defaultTestimonial.name}</p>
      <p class="testimonial-role" id="testimonial-role">{defaultTestimonial.role}</p>
    </div>

    <script>
      const el = document.getElementById('homepage-testimonial');
      if (el) {
        const list = JSON.parse(el.dataset.testimonials || '[]');
        if (list.length > 0) {
          const pick = list[Math.floor(Math.random() * list.length)];
          const quoteEl = document.getElementById('testimonial-quote');
          const nameEl = document.getElementById('testimonial-name');
          const roleEl = document.getElementById('testimonial-role');
          if (quoteEl) quoteEl.textContent = `"${pick.quote}"`;
          if (nameEl) nameEl.textContent = pick.name;
          if (roleEl) roleEl.textContent = pick.role;
        }
      }
    </script>

    <hr class="rule" />

    <section class="section split-section">
      <div class="split-col">
        <p class="section-label">Projects</p>
        <div class="compact-list">
          {featuredProjects.map((project, i) => (
            <div class="compact-item">
              <span class="compact-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="compact-body">
                <a href={`/projects/${project.slug}`} class="compact-title">{project.data.title}</a>
                <p class="compact-desc">{project.data.summary}</p>
                <div class="compact-links">
                  {project.data.externalUrl && (
                    <a href={project.data.externalUrl} class="compact-external" target="_blank" rel="noopener noreferrer">
                      Live ↗
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a href={project.data.repoUrl} class="compact-external" target="_blank" rel="noopener noreferrer">
                      Code ↗
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
        <a href="/projects" class="all-link">All projects →</a>
      </div>

      <div class="split-col split-col-divider">
        <p class="section-label">Writing</p>
        <div class="compact-list">
          {posts.map(post => (
            <a href={`/blog/${post.slug}`} class="compact-item compact-item-link">
              <span class="compact-date">{fmtDate(post.data.date)}</span>
              <div class="compact-body">
                <span class="compact-title">{post.data.title}</span>
                <p class="compact-desc">{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="compact-links">
                    <span class="compact-tag">{post.data.tags[0]}</span>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
        <a href="/blog" class="all-link">All writing →</a>
      </div>
    </section>

    <div class="availability">
      <p>Open to full-time TPM roles. No ticket filed yet — open to remote or relocation.</p>
      <a href="/contact" class="availability-cta">Get in touch →</a>
    </div>

  </div>
</BaseLayout>

<style>
.home {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 var(--gap);
}

/* ── Hero ─────────────────────────────────────── */
.hero {
  padding: 5rem 0 4.5rem;
}

.eyebrow {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink);
  opacity: 0.45;
  margin-bottom: 1.75rem;
}

.hero h1 {
  font-size: clamp(2.6rem, 6.5vw, 4.4rem);
  font-weight: 800;
  line-height: 1.06;
  letter-spacing: -0.03em;
  margin-bottom: 1.5rem;
  color: var(--ink);
}

.hero-accent {
  color: var(--accent);
}

.lead {
  font-size: 1rem;
  line-height: 1.75;
  opacity: 0.6;
  max-width: 52ch;
  margin-bottom: 2.5rem;
}

.hero-cta {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.availability {
  padding: 0 0 3.5rem;
  margin-top: 1rem;
}

.availability p {
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  opacity: 0.45;
}

.availability-cta {
  display: inline-block;
  margin-top: 0.5rem;
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  color: var(--accent);
  text-decoration: none;
}

.availability-cta:hover {
  text-decoration: underline;
}

/* ── Homepage testimonial ─────────────────────── */
.home-testimonial {
  margin: 0 0 2.75rem;
  border-left: 2px solid var(--accent);
  padding: 4px 0 4px 18px;
}

.home-testimonial .testimonial-quote {
  font-size: 14px;
  line-height: 1.6;
  opacity: 0.85;
  margin: 0 0 10px;
}

.home-testimonial .testimonial-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--ink);
  margin: 0;
}

.home-testimonial .testimonial-role {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--fg-2);
  margin-top: 2px;
}

/* ── Divider ──────────────────────────────────── */
.rule {
  border: none;
  border-top: 1px solid rgba(10, 10, 10, 0.12);
  margin: 0;
}

/* ── Sections ─────────────────────────────────── */
.section {
  padding: 3.5rem 0;
}

.section-label {
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  opacity: 0.4;
  margin-bottom: 2rem;
}

/* ── Split: Projects / Writing ───────────────────── */
.split-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 3rem;
  align-items: start;
}

.split-col {
  display: flex;
  flex-direction: column;
}

.split-col-divider {
  border-left: 1px solid rgba(10, 10, 10, 0.12);
  margin-left: -1.5rem;
  padding-left: 1.5rem;
}

.compact-list {
  margin-bottom: 1.25rem;
}

.compact-item {
  display: grid;
  grid-template-columns: 1.75rem 1fr;
  gap: 0.75rem;
  align-items: start;
  padding: 0.85rem 0;
  border-bottom: 1px solid rgba(10, 10, 10, 0.1);
}

.compact-item:first-child {
  border-top: 1px solid rgba(10, 10, 10, 0.1);
}

.compact-num {
  font-family: var(--mono);
  font-size: 0.85rem;
  font-weight: 700;
  opacity: 0.25;
  line-height: 1.4;
}

.compact-body {
  min-width: 0;
}

.compact-title {
  display: block;
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--ink);
  text-decoration: none;
  transition: color 0.15s;
}

.compact-title:hover {
  color: var(--accent);
}

.compact-desc {
  font-size: 0.8rem;
  line-height: 1.4;
  opacity: 0.55;
  margin-top: 0.25rem;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.compact-links {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.35rem;
}

.compact-external {
  display: inline-block;
  font-family: var(--mono);
  font-size: 0.72rem;
  opacity: 0.45;
  text-decoration: none;
  transition: opacity 0.15s;
}

.compact-tag {
  display: inline-block;
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.compact-external:hover {
  opacity: 1;
  color: var(--accent);
}

/* Writing rows: no number column, date + title inline */
.compact-item-link {
  grid-template-columns: 3.25rem 1fr;
  align-items: start;
  text-decoration: none;
}

.compact-item-link .compact-date {
  margin-top: 0.15rem;
}

.compact-item-link:hover .compact-title {
  color: var(--accent);
}

.compact-date {
  font-family: var(--mono);
  font-size: 0.72rem;
  opacity: 0.4;
  white-space: nowrap;
}

.compact-item-link .compact-title {
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Utility ──────────────────────────────────── */
.all-link {
  font-family: var(--mono);
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  opacity: 0.5;
  text-decoration: none;
  transition: opacity 0.15s;
}

.all-link:hover {
  opacity: 1;
  color: var(--accent);
}

/* ── Split: stack on tablet/mobile ────────────── */
@media (max-width: 900px) {
  .split-section {
    grid-template-columns: 1fr;
    row-gap: 2.5rem;
  }

  .split-col-divider {
    border-left: none;
    margin-left: 0;
    padding-left: 0;
  }
}

/* ── Mobile ───────────────────────────────────── */
@media (max-width: 640px) {
  .hero {
    padding: 3rem 0 3rem;
  }

  .br-desktop {
    display: none;
  }

  .compact-item-link {
    grid-template-columns: 1fr;
    gap: 0.2rem;
  }

  .compact-date {
    font-size: 0.68rem;
  }

}
</style>