---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const featuredProjects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

function fmtDate(d: Date) {
  const currentYear = new Date().getFullYear();
  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };
  if (d.getFullYear() !== currentYear) {
    opts.year = 'numeric';
  }
  return d.toLocaleDateString('en-US', opts);
}
---

<BaseLayout
  title="Galaxy Kadiyala — TPM · Systems · AI"
  description="Technical Program Manager focused on systems thinking, AI workflows, and building leverage. Based in Bengaluru."
>
  <div class="home">

    <section class="hero">
      <p class="eyebrow">Technical Program Manager &middot; AI &middot; Systems</p>
      <h1>Systems &gt; effort.<br/>I build leverage.</h1>
      <p class="lead">15+ years across Nutanix, Pure Storage, and Rubrik. 2 US patents in distributed systems. AI is a tool. Systems do the work.</p>
      <div class="hero-cta">
        <a href="/projects" class="btn">Projects</a>
        <a href="/blog" class="btn outline">Writing</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section split-section">
      <div class="split-col">
        <p class="section-label">Projects</p>
        <div class="compact-list">
          {featuredProjects.map((project, i) => (
            <div class="compact-item">
              <span class="compact-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="compact-body">
                <a href={`/projects/${project.slug}`} class="compact-title">{project.data.title}</a>
                <p class="compact-desc">{project.data.summary}</p>
                <div class="compact-links">
                  {project.data.externalUrl && (
                    <a href={project.data.externalUrl} class="compact-external" target="_blank" rel="noopener noreferrer">
                      Live ↗
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a href={project.data.repoUrl} class="compact-external" target="_blank" rel="noopener noreferrer">
                      Code ↗
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
        <a href="/projects" class="all-link">All projects →</a>
      </div>

      <div class="split-col split-col-divider">
        <p class="section-label">Writing</p>
        <div class="compact-list">
          {posts.map(post => (
            <a href={`/blog/${post.slug}`} class="compact-item compact-item-link">
              <span class="compact-date">{fmtDate(post.data.date)}</span>
              <div class="compact-body">
                <span class="compact-title">{post.data.title}</span>
                <p class="compact-desc">{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
        <a href="/blog" class="all-link">All writing →</a>
      </div>
    </section>

    <p class="availability">Currently open to full-time TPM roles. Bengaluru-based, open to remote. <a href="/contact">Get in touch →</a></p>

  </div>
</BaseLayout>

<style>
.home {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 var(--gap);
}

/* ── Hero ─────────────────────────────────────── */
.hero {
  padding: 5rem 0 4.5rem;
}

.eyebrow {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink);
  opacity: 0.45;
  margin-bottom: 1.75rem;
}

.hero h1 {
  font-size: clamp(2.6rem, 6.5vw, 4.4rem);
  font-weight: 800;
  line-height: 1.06;
  letter-spacing: -0.03em;
  margin-bottom: 1.5rem;
  color: var(--ink);
}

.lead {
  font-size: 1rem;
  line-height: 1.75;
  opacity: 0.6;
  max-width: 52ch;
  margin-bottom: 2.5rem;
}

.hero-cta {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.availability {
  padding: 0 0 3.5rem;
  margin-top: 1rem;
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  opacity: 0.45;
}

.availability a {
  color: inherit;
  text-decoration: none;
}

.availability a:hover {
  opacity: 1;
}

/* ── Divider ──────────────────────────────────── */
.rule {
  border: none;
  border-top: 1px solid rgba(10, 10, 10, 0.12);
  margin: 0;
}

/* ── Sections ─────────────────────────────────── */
.section {
  padding: 3.5rem 0;
}

.section-label {
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  opacity: 0.4;
  margin-bottom: 2rem;
}

/* ── Split: Projects / Writing ───────────────────── */
.split-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 3rem;
  align-items: start;
}

.split-col {
  display: flex;
  flex-direction: column;
}

.split-col-divider {
  border-left: 1px solid rgba(10, 10, 10, 0.12);
  margin-left: -1.5rem;
  padding-left: 1.5rem;
}

.compact-list {
  margin-bottom: 1.25rem;
}

.compact-item {
  display: grid;
  grid-template-columns: 1.75rem 1fr;
  gap: 0.75rem;
  align-items: start;
  padding: 0.85rem 0;
  border-bottom: 1px solid rgba(10, 10, 10, 0.1);
}

.compact-item:first-child {
  border-top: 1px solid rgba(10, 10, 10, 0.1);
}

.compact-num {
  font-family: var(--mono);
  font-size: 0.85rem;
  font-weight: 700;
  opacity: 0.25;
  line-height: 1.4;
}

.compact-body {
  min-width: 0;
}

.compact-title {
  display: block;
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--ink);
  text-decoration: none;
  transition: opacity 0.15s;
}

.compact-title:hover {
  opacity: 0.65;
}

.compact-desc {
  font-size: 0.8rem;
  line-height: 1.4;
  opacity: 0.55;
  margin-top: 0.25rem;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.compact-links {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.35rem;
}

.compact-external {
  display: inline-block;
  font-family: var(--mono);
  font-size: 0.72rem;
  opacity: 0.45;
  text-decoration: none;
  transition: opacity 0.15s;
}

.compact-external:hover {
  opacity: 1;
}

/* Writing rows: no number column, date + title inline */
.compact-item-link {
  grid-template-columns: 3.25rem 1fr;
  align-items: start;
  text-decoration: none;
  transition: opacity 0.15s;
}

.compact-item-link .compact-date {
  margin-top: 0.15rem;
}

.compact-item-link:hover {
  opacity: 0.6;
}

.compact-date {
  font-family: var(--mono);
  font-size: 0.72rem;
  opacity: 0.4;
  white-space: nowrap;
}

.compact-item-link .compact-title {
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Utility ──────────────────────────────────── */
.all-link {
  font-family: var(--mono);
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  opacity: 0.5;
  text-decoration: none;
  transition: opacity 0.15s;
}

.all-link:hover {
  opacity: 1;
}

/* ── Split: stack on tablet/mobile ────────────── */
@media (max-width: 900px) {
  .split-section {
    grid-template-columns: 1fr;
    row-gap: 2.5rem;
  }

  .split-col-divider {
    border-left: none;
    margin-left: 0;
    padding-left: 0;
  }
}

/* ── Mobile ───────────────────────────────────── */
@media (max-width: 640px) {
  .hero {
    padding: 3rem 0 3rem;
  }

  .br-desktop {
    display: none;
  }

  .compact-item-link {
    grid-template-columns: 1fr;
    gap: 0.2rem;
  }

  .compact-date {
    font-size: 0.68rem;
  }

}
</style>