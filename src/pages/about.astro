---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorldMap from '../components/WorldMap.astro';
import { testimonials } from '../data/testimonials';

const professionalTestimonials = testimonials.filter(t => t.group === 'professional');
const communityTestimonials = testimonials.filter(t => t.group === 'community');
---

<BaseLayout title="About" description="Galaxy Kadiyala — Technical Program Manager focused on systems, execution, and leverage. 15+ years across cloud, infrastructure, and platform engineering.">
  <section class="section" style="padding-bottom: 0">
    <div class="container">

      <div class="about-grid">

        <!-- Left: big statement -->
        <div class="about-left">
          <h1 class="about-title">
            TPM.<br/>
            Systems builder.<br/>
            <em>Open web</em> believer.
          </h1>
          <p class="about-tagline">Most work fails at execution. I fix that.</p>
        </div>

        <!-- Right: bio -->
        <div class="about-right">
          <div class="about-bio">
            <p>
              I work on systems that need to deliver, not just exist.
            </p>
            <p>
              Over the last 15+ years, I've worked across cloud, infrastructure, QA, and platform engineering. I focus on execution across distributed teams and complex dependencies.
            </p>
            <p>
              My focus is simple. Turn messy execution into systems that scale.
            </p>
            <p>
              Outside work, I've been part of the Mozilla community since 2010. I mentor contributors and help scale open web initiatives across the world.
            </p>
            <p>
              That experience shaped how I think. Systems over effort. Leverage over activity.
            </p>
          </div>

          <div class="about-links">
            <a href="/projects" class="btn">View Work →</a>
            <a href="/contact" class="btn outline">Get in touch →</a>
            <a href="/resume" class="btn outline">Resume ↗</a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <section class="testimonials-section">
    <div class="container">
      <p class="testimonials-eyebrow">What colleagues say</p>

      <div class="testimonials-group">
        <p class="testimonials-group-label">Professional</p>
        <div class="testimonials-grid">
          {professionalTestimonials.map(t => (
            <div class="testimonial">
              <p class="testimonial-quote">"{t.quote}"</p>
              <p class="testimonial-name">{t.name}</p>
              <p class="testimonial-role">{t.role}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="testimonials-group">
        <p class="testimonials-group-label">Community</p>
        <div class="testimonials-grid testimonials-grid--community">
          {communityTestimonials.map(t => (
            <div class="testimonial">
              <p class="testimonial-quote">"{t.quote}"</p>
              <p class="testimonial-name">{t.name}</p>
              <p class="testimonial-role">{t.role}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="metrics-section">
    <div class="container">
      <p class="metrics-eyebrow">By the numbers</p>
      <div class="metrics-grid" aria-label="Credibility metrics">
        <div class="metric-tile">
          <p class="metric-number">15+</p>
          <p class="metric-label">years as a Technical Program Manager</p>
        </div>
        <div class="metric-tile">
          <p class="metric-number">2</p>
          <p class="metric-label">US patents in distributed systems</p>
        </div>
        <div class="metric-tile">
          <p class="metric-number">10,000+</p>
          <p class="metric-label">students engaged through Mozilla community work</p>
        </div>
        <div class="metric-tile">
          <p class="metric-number">7d → 24h</p>
          <p class="metric-label">release cycle compression on production CI/CD</p>
        </div>
      </div>
    </div>
  </section>

  <section class="career-timeline">
    <div class="container">
      <p class="section-label">Where I've built</p>
      <div class="timeline">
        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <p class="timeline-years">2011–2017</p>
          <p class="timeline-company">Terralogic</p>
          <p class="timeline-role">Technical Lead</p>
        </div>
        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <p class="timeline-years">2017–2024</p>
          <p class="timeline-company">Nutanix</p>
          <p class="timeline-role">Senior MTS → Engineering Manager</p>
        </div>
        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <p class="timeline-years">2024–2025</p>
          <p class="timeline-company">Everpure</p>
          <p class="timeline-subtitle">via Aziro</p>
          <p class="timeline-role">Technical Program Manager</p>
        </div>
        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <p class="timeline-years">2025–present</p>
          <p class="timeline-company">Rubrik</p>
          <p class="timeline-subtitle">via Aziro</p>
          <p class="timeline-role">Technical Program Manager</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <WorldMap />
  </div>

</BaseLayout>

<style>
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 0;
}

.about-title {
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  line-height: 1.05;
  letter-spacing: -0.03em;
  margin-bottom: 1.25rem;
}
.about-title em {
  font-family: var(--sans);
  font-style: normal;
  font-weight: 800;
  color: var(--accent);
}

.about-tagline {
  font-family: var(--mono);
  font-size: 0.82rem;
  color: var(--fg-2);
  margin-bottom: 1.75rem;
  letter-spacing: 0.01em;
}

.about-bio {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  margin-bottom: 2.5rem;
}
.about-bio p {
  font-size: 1.05rem;
  opacity: 0.8;
  line-height: 1.75;
}

.about-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}


/* ── Testimonials ─────────────────────────────── */
.testimonials-section {
  padding: 3rem 0 0;
}

.testimonials-eyebrow {
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--fg-2);
  margin-bottom: 1.5rem;
}

.testimonials-group {
  margin-bottom: 2.5rem;
}
.testimonials-group:last-child {
  margin-bottom: 0;
}

.testimonials-group-label {
  font-family: var(--mono);
  font-size: 0.62rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--fg-2);
  opacity: 0.7;
  margin-bottom: 1rem;
}

.testimonials-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

/* Community group has 3 items — let the 3rd span full width instead of
   leaving an awkward lopsided gap next to a lone 2-column card. */
.testimonials-grid--community > :nth-child(3):last-child {
  grid-column: 1 / -1;
}

.testimonial {
  border-left: 2px solid var(--accent);
  padding: 4px 0 4px 20px;
}

.testimonial-quote {
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink);
  margin: 0 0 14px;
}

.testimonial-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--ink);
  margin: 0;
}

.testimonial-role {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--fg-2);
  margin-top: 2px;
}

@media (max-width: 768px) {
  .testimonials-grid {
    grid-template-columns: 1fr;
  }
}

/* ── Metrics ──────────────────────────────────── */
.metrics-section {
  padding: 3rem 0 3.5rem;
}

.metrics-eyebrow {
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--fg-2);
  margin-bottom: 1.5rem;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  align-items: stretch;
}

.metric-tile {
  background: var(--paper-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.metric-number {
  font-family: var(--sans);
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--accent);
}

.metric-label {
  font-family: var(--mono);
  font-size: 0.875rem;
  color: var(--fg-2);
  letter-spacing: 0.01em;
  line-height: 1.5;
}

@media (max-width: 1024px) {
  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ── Career timeline ──────────────────────────── */
.career-timeline {
  padding: 2rem 0;
}

.section-label {
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--fg-2);
  margin-bottom: 1.5rem;
}

.timeline {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 24px;
  margin-top: 2rem;
}

.timeline::before {
  content: '';
  position: absolute;
  top: 4px;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--accent);
  opacity: 0.35;
}

.timeline-node {
  position: relative;
  flex: 1;
  min-width: 0;
}

.timeline-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--accent);
  margin-bottom: 16px;
}

.timeline-years {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--fg-3);
  margin: 0 0 4px;
}

.timeline-company {
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--ink);
}

.timeline-subtitle {
  font-family: var(--mono);
  font-size: 0.68rem;
  color: var(--fg-3);
  margin: 0 0 4px;
  font-style: italic;
}

.timeline-role {
  font-size: 0.82rem;
  color: var(--fg-2);
  line-height: 1.4;
  margin: 0;
}

@media (max-width: 640px) {
  .timeline {
    flex-direction: column;
    gap: 24px;
  }
  .timeline::before {
    top: 0;
    bottom: 0;
    left: 4px;
    right: auto;
    width: 1px;
    height: auto;
  }
  .timeline-node {
    padding-left: 20px;
  }
  .timeline-dot {
    position: absolute;
    left: -4px;
    top: 4px;
    margin: 0;
  }
}

/* ── Responsive ───────────────────────────────── */
@media (max-width: 768px) {
  .about-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
}

@media (max-width: 640px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
</style>
