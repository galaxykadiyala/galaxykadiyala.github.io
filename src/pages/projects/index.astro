---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Reuses each project's existing detail-page hero image (see the Phase 4
// MDX bodies) — filenames/folders predate this grid and don't follow a
// single slug convention, so map explicitly rather than guessing a path.
const heroImages: Record<string, string> = {
  'ai-built-learning-platform': '/images/projects/ai-built-learning-platform/hero.png',
  'glucose-optimization-system': '/images/projects/glyco/dashboard.png',
  'spendlens': '/images/projects/spendlens/overview.png',
  'stock-copilot': '/images/projects/stock-copilot/hero.png',
};

// Terminal chrome-bar path label — the real app/repo name, not always the
// same as the content slug (e.g. the learning platform's slug is
// "ai-built-learning-platform" but the actual project is "smartsprouts").
const chromePaths: Record<string, string> = {
  'ai-built-learning-platform': '~/projects/smartsprouts',
  'glucose-optimization-system': '~/projects/glyco',
  'spendlens': '~/projects/spendlens',
  'stock-copilot': '~/projects/stock-copilot',
};
---

<BaseLayout title="Projects" description="Programs Galaxy Kadiyala has shipped, systems built, and communities been part of.">
  <section class="section">
    <div class="container">

      <div class="page-header">
        <div class="page-header-text">
          <h1>Projects</h1>
          <p>Things I've built. Professional case studies live in <a href="/blog">Writing</a>.</p>
        </div>
        <a href="https://github.com/galaxykadiyala" target="_blank" rel="noopener" class="btn outline">
          GitHub →
        </a>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <a href={`/projects/${project.slug}`} class="project-card">
            <div class="chrome-bar">
              <span class="dot dot-active"></span>
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="chrome-path">{chromePaths[project.slug]}</span>
            </div>
            <div class="screenshot-window">
              <img
                class="project-screenshot"
                src={heroImages[project.slug]}
                alt={`${project.data.title} screenshot`}
                loading="lazy"
              />
              <span class="status-badge">{project.data.status}</span>
            </div>
            <div class="card-body">
              <p class="project-year">{project.data.year}</p>
              <h3 class="project-title">{project.data.title}</h3>
              <p class="project-desc">{project.data.summary}</p>
              {project.data.techStack && (
                <p class="project-tags">
                  {project.data.techStack.slice(0, 2).map((tag, i) => (
                    <>
                      <span class="project-tag">{tag}</span>
                      {i < Math.min(project.data.techStack.length, 2) - 1 && (
                        <span class="project-tag-sep">/</span>
                      )}
                    </>
                  ))}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 2px solid var(--ink);
}
.page-header h1 { margin-bottom: 0.4rem; }
.page-header p {
  font-family: var(--mono);
  font-size: 0.85rem;
  opacity: 0.5;
}
.page-header p a {
  text-decoration: underline;
  text-decoration-color: currentColor;
  opacity: 0.8;
}
.page-header p a:hover {
  opacity: 1;
  color: var(--accent);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  align-items: start;
  gap: 24px;
}

.project-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  background: var(--paper-2);
  text-decoration: none;
  color: var(--ink);
  transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
}
.project-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  border-color: var(--accent);
}

/* ── Terminal chrome bar ──────────────────────── */
.chrome-bar {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  background: var(--paper-2);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border);
  display: inline-block;
  margin-right: 4px;
}
.dot-active {
  background: var(--accent);
}

.chrome-path {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--fg-3);
  margin-left: 8px;
}

/* ── Screenshot window ────────────────────────── */
.screenshot-window {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  flex-shrink: 0;
}

.project-screenshot {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  filter: grayscale(1) contrast(1.05);
}

/* Coral-tinted duotone wash — keeps every screenshot in the same color
   mood regardless of its original palette. */
.screenshot-window::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(229, 57, 53, 0.08) 0%,
    rgba(20, 15, 12, 0.35) 100%
  );
}
[data-theme="dark"] .screenshot-window::after {
  background: linear-gradient(
    180deg,
    rgba(236, 107, 104, 0.1) 0%,
    rgba(20, 15, 12, 0.35) 100%
  );
}

.status-badge {
  position: absolute;
  z-index: 1;
  bottom: 8px;
  right: 12px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent);
}

/* ── Card body ────────────────────────────────── */
.card-body {
  padding: 20px;
}

.project-year {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--fg-2);
  margin-bottom: 4px;
}

.project-title {
  font-size: 1.15rem;
  font-weight: 700;
  margin-bottom: 6px;
}

.project-desc {
  font-size: 0.85rem;
  line-height: 1.4;
  color: var(--fg-2);
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.project-tags {
  font-family: var(--mono);
  font-size: 12px;
}

.project-tag {
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--accent);
}

.project-tag-sep {
  color: var(--ink);
  margin: 0 8px;
  opacity: 0.3;
}

@media (max-width: 720px) {
  .projects-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .page-header { flex-direction: column; align-items: flex-start; }
}
</style>
