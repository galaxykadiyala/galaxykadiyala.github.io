---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Reuses each project's existing detail-page hero image (see the Phase 4
// MDX bodies) — filenames/folders predate this grid and don't follow a
// single slug convention, so map explicitly rather than guessing a path.
const heroImages: Record<string, string> = {
  'ai-built-learning-platform': '/images/projects/ai-built-learning-platform/hero.png',
  'glucose-optimization-system': '/images/projects/glyco/dashboard.png',
  'spendlens': '/images/projects/spendlens/overview.png',
  'stock-copilot': '/images/projects/stock-copilot/hero.png',
};
---

<BaseLayout title="Projects" description="Programs Galaxy Kadiyala has shipped, systems built, and communities been part of.">
  <section class="section">
    <div class="container">

      <div class="page-header">
        <div class="page-header-text">
          <h1>Projects</h1>
          <p>Things I've built. Professional case studies live in <a href="/blog">Writing</a>.</p>
        </div>
        <a href="https://github.com/galaxykadiyala" target="_blank" rel="noopener" class="btn outline">
          GitHub →
        </a>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="project-card"
          >
            <div
              class="project-card-image"
              style={`background-image: url(${heroImages[project.slug]})`}
            ></div>
            <span class="project-badge">{project.data.status}</span>
            <div class="project-card-content">
              <p class="project-year">{project.data.year}</p>
              <p class="project-title">{project.data.title}</p>
              <p class="project-desc">{project.data.summary}</p>
              {project.data.techStack && (
                <div class="project-tags">
                  {project.data.techStack.slice(0, 2).map((tag) => (
                    <span class="project-tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 2px solid var(--ink);
}
.page-header h1 { margin-bottom: 0.4rem; }
.page-header p {
  font-family: var(--mono);
  font-size: 0.85rem;
  opacity: 0.5;
}
.page-header p a {
  text-decoration: underline;
  text-decoration-color: currentColor;
  opacity: 0.8;
}
.page-header p a:hover {
  opacity: 1;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

/* Lone trailing card (e.g. the 4th project in a 3-wide row) spans full
   width and centers instead of sitting alone on the left. This container
   caps at 1100px, so auto-fill never resolves past 3 columns — the 3n
   formula holds at every width wide enough to reach 3 columns at all. */
@media (min-width: 860px) {
  .projects-grid > *:last-child:nth-child(3n + 1) {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
}

.project-card {
  position: relative;
  display: block;
  height: 320px;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: white;
  transition: transform 0.15s, box-shadow 0.15s;
}
.project-card:hover {
  transform: translate(-4px, -4px);
  box-shadow: 6px 6px 0 var(--ink);
}

/* Image lives in its own layer so the grayscale filter doesn't wash out
   the badge/title/text stacked on top of it. */
.project-card-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center top;
  filter: grayscale(1) contrast(1.05);
}

/* Coral-tinted duotone wash — keeps every card's screenshot in the same
   color mood regardless of its original palette, and darkens toward the
   bottom so the title/description/tags stay legible. */
.project-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(229, 57, 53, 0.10) 0%,
    rgba(20, 15, 12, 0.55) 55%,
    rgba(20, 15, 12, 0.88) 100%
  );
}
[data-theme="dark"] .project-card::before {
  background: linear-gradient(
    180deg,
    rgba(236, 107, 104, 0.12) 0%,
    rgba(20, 15, 12, 0.55) 55%,
    rgba(20, 15, 12, 0.88) 100%
  );
}

.project-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(255,255,255,0.15);
  color: white;
  backdrop-filter: blur(4px);
}

.project-card-content {
  position: absolute;
  z-index: 2;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px;
}

.project-year {
  font-family: var(--mono);
  font-size: 0.72rem;
  opacity: 0.7;
  margin-bottom: 4px;
}

.project-title {
  font-size: 1.15rem;
  font-weight: 700;
  margin-bottom: 6px;
}

.project-desc {
  font-size: 0.85rem;
  line-height: 1.4;
  opacity: 0.85;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.project-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.project-tag {
  font-family: var(--mono);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 8px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.3);
  color: rgba(255,255,255,0.9);
}

@media (max-width: 640px) {
  .page-header { flex-direction: column; align-items: flex-start; }
}
</style>
